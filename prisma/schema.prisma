

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  createdAt    DateTime @default(now())
  refreshToken String?

  settings UserSettings?
}

model UserSettings {
  id      String   @id @default(uuid())
  userId    String   @unique
  latitude  Float?
  longitude Float?
  method    Int      @default(13)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Surah {
  id                 Int      @id
  name               String   
  englishName        String
  englishTranslation String
  numberOfAyahs      Int
  revelationType     String

  verses Verse[]
}


model Verse {
  id       Int    @id @default(autoincrement())
  surahId  Int
  number   Int
  text     String
  translation String?
  audioUrl    String?
  globalNumber Int    @unique 

  surah Surah @relation(fields: [surahId], references: [id])
}

model Juz {
  id     Int      @id
  verses JuzVerse[]
}

model JuzVerse {
  id       Int @id @default(autoincrement())
  juzId    Int
  surahId  Int
  number   Int
  text     String

  juz Juz @relation(fields: [juzId], references: [id])

  @@unique([juzId, surahId, number])
}